{
  "name": "dsh-client-ui-skin-bayern",
  "description": "FC Bayern München skin for the dsh web GUI: home-red / away-white canvases, 19 first-team player match photos plus drawn shirt, squad wall, Allianz-Arena and plain backdrops, 4 accent colours.",
  "version": "0.4.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "skin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "preview",
    "docs",
    "photos"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "author": "dirtywork22",
  "homepage": "https://github.com/dirtywork22/dsh-client-ui-skin-bayern#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dirtywork22/dsh-client-ui-skin-bayern.git"
  },
  "bugs": {
    "url": "https://github.com/dirtywork22/dsh-client-ui-skin-bayern/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-client",
    "deepseek-harness",
    "skin",
    "theme",
    "bayern",
    "fcb",
    "football",
    "soccer"
  ]
}
